# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# Amiga build output (out/a.s disassembly; a.exe/a.elf/a.map covered by the rules above)
out/*.s

# Keep the asset-conversion script -- the generic *.cmd rule above would otherwise hide it
!gfx/convert.cmd

# VSCode workspace settings. The amiga-debug extension writes an absolute, machine-specific
# toolchain path (m68k.includePaths) into this file on activation, so it cannot be shared.
# See .vscode/settings.json.example for the project-level settings.
.vscode/settings.json
